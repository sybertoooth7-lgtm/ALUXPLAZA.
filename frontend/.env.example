# No secrets here — the CSRF token comes from the server cookie
VITE_API_BASE_URL=http://localhost:3001   # or your deployed backend URL

# Optional — error tracking. Leave blank for local dev; Sentry DSNs are
# not secret (they're baked into every browser bundle by design), but
# there's no reason to spam your Sentry project with local noise.
VITE_SENTRY_DSN=
